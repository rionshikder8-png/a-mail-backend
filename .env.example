# ============================================================
# A-Mail backend configuration.   Copy this file to ".env"
# (cPanel File Manager: Settings > Show Hidden Files) and fill it in.
# NEVER commit or share the real .env.
# ============================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.adverune.store
MAIL_DOMAIN=adverune.store

# --- MySQL (cPanel > MySQL Databases). Name and user carry your account prefix.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpuser_amail
DB_USER=cpuser_amail
DB_PASS=

# --- Secrets: long random strings, all different. Make them with any password generator (64 characters).
APP_KEY=
TOKEN_PEPPER=

# --- One-time web setup wizard (no SSH needed). Random, 24+ characters. Remove after setup.
SETUP_TOKEN=

# --- Private file storage. Leave empty to use ./storage, or point ABOVE the web root, e.g. /home/cpuser/amail-storage
STORAGE_PATH=

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
OTP_TTL=600

# --- Sending mail: your cPanel mail server.
# Create a mailbox in cPanel > Email Accounts, e.g. system@adverune.store, and use its FULL address + password here.
# Host: use the server name from cPanel > Email Accounts > Connect Devices ("Mail Client Manual Settings").
# Port 465 with SMTP_SECURITY=ssl  (or port 587 with SMTP_SECURITY=tls).
SMTP_HOST=mail.adverune.store
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=system@adverune.store
SMTP_PASS=
SMTP_FROM_NAME=A-Mail

# --- Receiving mail. Preferred: cPanel "Default Address" piped to mail/pipe.php (see README), no settings needed here.
# The next three are ONLY for the IMAP fallback.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Only for the HTTP hook (used by relay services such as Mailgun routes). Random 32+ chars.
INBOUND_SECRET=

# --- DKIM: cPanel signs outgoing mail for you under Email Deliverability. Leave blank unless you manage your own key.
DKIM_SELECTOR=amail
DKIM_PRIVATE_KEY_PATH=

# --- Push notifications (optional)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

DEFAULT_QUOTA_BYTES=1073741824
MAX_ATTACHMENT_BYTES=20971520
ADMIN_ALLOWED_IPS=
