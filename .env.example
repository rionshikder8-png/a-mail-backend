# Copy to .env and fill in. NEVER commit .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.adverune.store
MAIL_DOMAIN=adverune.store

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amail
DB_USER=amail
DB_PASS=

# Long random strings (e.g. `openssl rand -hex 32`)
APP_KEY=
TOKEN_PEPPER=

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
OTP_TTL=600

# Outbound SMTP relay (leave empty to disable external delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=A-Mail

# Inbound IMAP mailbox that receives mail for the domain (optional)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
INBOUND_SECRET=

# DKIM (path to private key kept OUTSIDE the web root)
DKIM_SELECTOR=amail
DKIM_PRIVATE_KEY_PATH=

# Push (FCM HTTP v1 service-account JSON path, outside web root)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

DEFAULT_QUOTA_BYTES=1073741824
MAX_ATTACHMENT_BYTES=20971520
ADMIN_ALLOWED_IPS=
